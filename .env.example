# Database connection used by the backend and docker compose
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=hrm_database

# Auth / cookies
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CORS
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80,http://localhost:5173

# SQL logging
SQL_ECHO=false

# Seed users created at startup
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_EMAIL=admin@hrmapp.com
DEFAULT_ADMIN_ROLE=admin
DEFAULT_ADMIN_PASSWORD=Admin@2026!HRM
DEFAULT_HR_USER=hr
DEFAULT_HR_EMAIL=hr@hrmapp.com
DEFAULT_HR_ROLE=hr_manager
DEFAULT_HR_PASSWORD=Hr@2026!HRM